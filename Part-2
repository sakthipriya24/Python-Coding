def gcd_euclidean(n1,n2):
    if n2==0:
        return n1
    return gcd_euclidean(n2,n1%n2)
    
def gcd_brute_force(n1,n2):
    if n1<n2:
        min_num = n1
    else:
        min_num = n2
    for i in range(min_num,1,-1):
        if n1%i==0 and n2%i==0:
            return i
    return 1

def gcd_method(n1,n2):
    import math
    return math.gcd(n1,n2)

def lcm_with_gcd_euclidean(n1, n2):
    def gcd(a, b):
        if b == 0:
            return a
        return gcd(b, a % b)
    return (n1 * n2) // gcd(n1, n2)

def lcm_brute_force(n1,n2):
    max_num = max(n1,n2)
    candidate = max_num
    while True:
        if candidate%n1==0 and candidate%n2==0:
            return candidate
        candidate+=max_num

def lcm_math_method(n1,n2):
    import math
    return math.lcm(n1,n2)

print(gcd_euclidean(48,18))
print(gcd_brute_force(7,9))
print(gcd_method(48,18))
print(lcm_with_gcd_euclidean(4,6))
print(lcm_brute_force(4,6))
print(lcm_math_method(4,6))

