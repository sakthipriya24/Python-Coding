def find_largest(li):
    max_num = li[0]
    for i in range(1, len(li)):
        if li[i ]> max_num:
            max_num = li[i]
    return max_num

def find_second_largest(li):
    large = float('-inf')
    second_large = float('-inf')
    for num in li:
        if num>large:
            second_large=large
            large=num
        elif num>second_large and num!=large:
            second_large=num
    return second_large

def is_sorted(li):
    for i in range(len(li)-1):
        if li[i]>li[i+1]:
            return False
    return True

def remove_duplicates_two_pointer(sorted_li):
    read = 1
    write = 1
    while read<len(sorted_li):
        if sorted_li[read]!=sorted_li[read-1]:
            sorted_li[write]=sorted_li[read]
            write+=1
        read+=1
    return write

def move_zeros_to_end_two_pointer(li):
    read=0
    write=0
    while read<len(li):
        if li[read]!=0:
            li[write]=li[read]
            if read!=write: # works for non zero list of elements
                li[read]=0
            write+=1
        read+=1
    return li

def reverse_array_in_place(li):
    read=0
    write=len(li)-1
    while read<write:
        li[read],li[write]=li[write],li[read]
        read+=1
        write-=1
    return li

print(find_largest([3, 7, 2, 9, 5]))
print(find_second_largest([3,7,2,9,5]))
print(is_sorted([1,2,3,4]))
print(remove_duplicates_two_pointer([1, 1, 2, 2, 3]))
print(move_zeros_to_end_two_pointer([0,1,0,3,12]))
print(reverse_array_in_place([1,2,3,4,5]))
