def find_largest(li):
    max_num = li[0]
    for i in range(1, len(li)):
        if li[i ]> max_num:
            max_num = li[i]
    return max_num

def find_second_largest(li):
    large = float('-inf')
    second_large = float('-inf')
    for num in li:
        if num>large:
            second_large=large
            large=num
        elif num>second_large and num!=large:
            second_large=num
    return second_large

print(find_largest([3, 7, 2, 9, 5]))
print(find_second_largest([3,7,2,9,5]))
