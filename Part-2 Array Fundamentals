def find_largest(li):
    max_num = li[0]
    for i in range(1, len(li)):
        if li[i ]> max_num:
            max_num = li[i]
    return max_num

def find_second_largest(li):
    large = float('-inf')
    second_large = float('-inf')
    for num in li:
        if num>large:
            second_large=large
            large=num
        elif num>second_large and num!=large:
            second_large=num
    return second_large

def is_sorted(li):
    for i in range(len(li)-1):
        if li[i]>li[i+1]:
            return False
    return True

def remove_duplicates_two_pointer(sorted_li):
    read = 1
    write = 1
    while read<len(sorted_li):
        if sorted_li[read]!=sorted_li[read-1]:
            sorted_li[write]=sorted_li[read]
            write+=1
        read+=1
    return write

def move_zeros_to_end_two_pointer(li):
    read=0
    write=0
    while read<len(li):
        if li[read]!=0:
            li[write]=li[read]
            if read!=write: # works for non zero list of elements
                li[read]=0
            write+=1
        read+=1
    return li

def reverse_array_in_place(li):
    read=0
    write=len(li)-1
    while read<write:
        li[read],li[write]=li[write],li[read]
        read+=1
        write-=1
    return li

def reverse_helper(li, read, write):
    while read<write:
        li[read],li[write]=li[write],li[read]
        read+=1
        write-=1
        
def rotate_by_k(li, k):
    if not li:
        return li
    k = k%len(li) # avoid unnecessary rotations
    reverse_helper(li, 0, len(li)-1)
    reverse_helper(li, 0, k-1)
    reverse_helper(li, k, len(li)-1)
    return li

def max_sub_arr_sum_kadane_alg(arr):
    current_sum=arr[0]
    max_sum=arr[0]
    for i in arr[1:]:
        current_sum=max(i,i+current_sum)
        max_sum=max(max_sum, current_sum)
    return max_sum

def sub_arr_with_given_sum_sliding_window(arr, k):
    left = 0
    current_sum = 0
    for right in range(len(arr)):
        current_sum += arr[right]
        while current_sum > k:
            current_sum -= arr[left]
            left += 1
        if current_sum == k:
            return True
    return False

print(find_largest([3, 7, 2, 9, 5]))
print(find_second_largest([3,7,2,9,5]))
print(is_sorted([1,2,3,4]))
print(remove_duplicates_two_pointer([1, 1, 2, 2, 3]))
print(move_zeros_to_end_two_pointer([0,1,0,3,12]))
print(reverse_array_in_place([1,2,3,4,5]))
print(rotate_by_k([1,2,3,4,5,6,7],3))
print(max_sub_arr_sum_kadane_alg([-5, -2, -3]))
print(sub_arr_with_given_sum_sliding_window([1, 2, 3, 4, 5], 9))

